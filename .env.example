# Exemple de configuration pour la distribution Fabrica Miracula (local uniquement).
# Copiez ce fichier en `.env` et renseignez vos VRAIES clés.
# Le fichier `.env` est ignoré par git (.gitignore) et ne doit JAMAIS être commité.
# En production (GitHub Actions), ces valeurs sont injectées via les GitHub Secrets.

# X (Twitter) — OAuth 1.0a, 4 clés issues de https://developer.twitter.com
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Meta (Facebook & Instagram) — Graph API
# Token d'accès page/instagram (https://developers.facebook.com/tools/explorer)
META_ACCESS_TOKEN=
# ID numérique de la page Facebook
META_FB_PAGE_ID=
# ID numérique du compte Instagram Business lié à la page
META_IG_USER_ID=
# URL d'une image par défaut pour les publications Instagram (obligatoire)
META_IG_DEFAULT_IMAGE=

# LinkedIn — API UGC Posts
# Token d'accès personnel (https://www.linkedin.com/developers) avec w_member_social
LINKEDIN_ACCESS_TOKEN=
# URN de l'utilisateur, ex. urn:li:person:AbC123 (ou juste AbC123)
LINKEDIN_USER_ID=

# Configuration
# 1 = mode simulation (affiche les messages sans les poster)
DISTRIBUTE_DRY_RUN=1
SITE_URL=https://voisin71-sys.github.io/fabrica-miracula/
